# Meadow PIM — production environment (VPS). Copy to `.env.vps` on the server
# and fill in secrets. NEVER commit `.env.vps`.
# Docs: plan/detail/betrieb-deployment.md §4.
#
# Everything here is read by docker-compose.vps.yml and by the scripts in
# scripts/. Only the entries a container needs are passed through (the compose
# file lists them).

# --- Image tags & registry ---------------------------------------------------
# Registry that holds the images (any OCI registry). The path must be lowercase
# (Forgejo rejects upper case; other registries do not care).
# Build and push with `./scripts/build-images.sh --push` (Windows:
# `powershell -File scripts/build-images.ps1 -Push`); it prints the immutable tag
# it just pushed — pin it here so a deploy is reproducible and a rollback is
# `PIM_*_TAG=<older tag>` plus a deploy.
PIM_REGISTRY=registry.example.com/meadow
PIM_CORE_TAG=latest
PIM_FRONTEND_TAG=latest
PIM_WORKER_TAG=latest

# Optional: registry login without a prompt (cron/automation). Without these the
# deploy script runs the interactive `docker login`. Use an access token with
# push permission as the password.
# DOCKER_REGISTRY_USER=CHANGE_ME
# DOCKER_REGISTRY_PASSWORD=CHANGE_ME

# --- Traefik hostnames ------------------------------------------------------
PIM_UI_HOST=pim.example.com
PIM_API_HOST=pim-api.example.com
# External Docker network shared with the reverse proxy (it must exist on the
# host; `deploy-vps-meadow.sh` creates it if it is missing).
TRAEFIK_NETWORK=traefik-net

# --- SurrealDB --------------------------------------------------------------
# Service name on the internal network — not 127.0.0.1.
SURREALDB_URL=surrealdb:8000
SURREALDB_USER=CHANGE_ME
SURREALDB_PASS=CHANGE_ME
SURREALDB_NAMESPACE=meadow
SURREALDB_DATABASE=meadow
# Host-side address of the database for the admin scripts (`POST /sql`; the
# compose file binds the port to loopback). Used by scripts/run-migration.sh and
# scripts/restore-vps-db.sh.
SURREALDB_HTTP_URL=http://127.0.0.1:8000
# Bytes per restore batch (see scripts/restore-vps-db.sh: the endpoint refuses
# bodies above roughly 4 MB).
RESTORE_CHUNK_BYTES=2097152

# --- NATS (JetStream). Auth is an optional later hardening step; the MVP runs
# --- without server-side auth, so the URLs below carry no credentials.
NATS_URL=nats://nats:4222
# NATS_USER=CHANGE_ME
# NATS_PASS=CHANGE_ME

# --- Jobs (JetStream publish, core) -----------------------------------------
JOBS_NATS_URL=nats://nats:4222
JOBS_STREAM_MAX_AGE_MINUTES=1440

# --- Events (transactional outbox + relay, core) ----------------------------
EVENTS_NATS_URL=nats://nats:4222
EVENT_RELAY_INTERVAL_S=5
EVENTS_STREAM_MAX_AGE_DAYS=30
EVENTS_STREAM_MAX_BYTES=1073741824   # 1 GiB

# --- Object storage (MinIO) --------------------------------------------------
# These are the names the frontend and the worker read; the same values are
# MinIO's root credentials (see docker-compose.vps.yml).
S3_ENDPOINT_URL=http://object-storage:9000
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=meadow
S3_REGION=us-east-1
# Above this size an export is archived into the bucket instead of travelling
# inline through job_run.result (the frontend then streams it from the bucket).
EXPORT_INLINE_MAX_BYTES=1000000

# --- Licensed BMEcat schema (optional) ---------------------------------------
# resources/ is neither in Git nor in an image, so export validation reports
# "schema not found" unless the file is mounted. Copy the artefact to the server
# and point this at the path *inside* the container (add the bind mount to the
# worker and frontend service).
# BMECAT_XSD=/resources/bmecat/bmecat_etim_501.xsd

# --- JWT --------------------------------------------------------------------
# Signs every access token. There is no default, and the core refuses to start
# with fewer than 32 characters (which the placeholder below is).
JWT_SECRET=CHANGE_ME
JWT_TTL_SECONDS=3600

# --- Core/Frontend URL ------------------------------------------------------
PIM_CORE_URL=http://pim-core:8080

# --- Frontend session -------------------------------------------------------
# Signs the browser session cookie. There is no default, and the frontend
# refuses to start with fewer than 32 characters (which the placeholder below is).
UI_STORAGE_SECRET=CHANGE_ME

# --- Request limits (Phase 8) ------------------------------------------------
PIM_MAX_BODY_BYTES=10485760        # 10 MiB
PIM_RATE_LIMIT_PER_MINUTE=0        # 0 = disabled (per-IP, read from peer socket)

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# Curated system logs in SurrealDB (admin UI). Resetting a value in the UI
# deletes its database entry, so these stay the commissioning defaults.
LOG_PERSIST_LEVEL=WARN
LOG_PERSIST_CATEGORIES=app,rule
LOG_RETENTION_DAYS=30
LOG_RATE_LIMIT=1000
LOG_CLEANUP_INTERVAL_S=3600

# --- Business rules (synchronous write path, core) ---------------------------
RULES_NATS_URL=nats://nats:4222
RULES_SUBJECT=rules.evaluate
RULES_COMPILE_SUBJECT=rules.compile
RULES_TIMEOUT_MS=2000
RULES_DEGRADE=false
RULES_BREAKER_THRESHOLD=3

# --- Log ingestion (core) & worker log sender --------------------------------
# Must hold the same value on both sides: the core accepts the `x-api-key`
# header only when this is set, and every worker write path uses it.
LOG_INGEST_API_KEY=CHANGE_ME
LOG_FLUSH_INTERVAL_S=5
LOG_CONFIG_REFRESH_INTERVAL_S=60

# --- Scheduler (core) -------------------------------------------------------
SCHEDULER_INTERVAL_S=60

# --- Deploy behaviour (read by scripts/deploy-vps-meadow.sh) -----------------
AUTO_RUN_DB_MIGRATIONS=true          # false = skip scripts/run-migration.sh
AUTO_BASELINE_DB_MIGRATIONS=true     # book a database that already has the core schema
RUN_POST_DEPLOY_HEALTHCHECK=true     # false = do not run healthcheck-vps.sh at the end

# --- Backup ------------------------------------------------------------------
BACKUP_DIR=backups/db
BACKUP_RETENTION_DAYS=14
